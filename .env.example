# Django Configuration
SECRET_KEY=django-insecure-the-tea-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Database Configuration (Supabase PostgreSQL / SQLite Fallback)
USE_SQLITE=True
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_password
DB_HOST=db.your_supabase_project.supabase.co
DB_PORT=5432

# Email & OTP Settings (Console backend by default for dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=The Tea System <noreply@thetea.local>
